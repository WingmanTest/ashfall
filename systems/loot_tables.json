{
  "version": 2,
  "units": {
    "rolls": "[min,max] entries drawn (uniform int) per container",
    "weight": "relative weight",
    "qty": "[min,max] uniform int",
    "empty_chance": "0..1 chance container is empty before rolls",
    "guaranteed": "fixed story/level items per area visit (item: count)",
    "rad_zones": "share of the area's outdoor space at each zone level (see survival.json)"
  },
  "roll_algorithm": [
    "if rand() < clamp(container.empty_chance + act.empty_chance_add + difficulty.loot_empty_add, 0, 0.95): empty",
    "n = randint(rolls) ",
    "for each roll: pick entry by weight' = weight * act.category_weight_mult[item.category] * area.category_bias[cat] * item_act_weight_mult[item][act] (entries whose item is act-gated and not yet available get weight 0)",
    "qty = randint(entry.qty) * difficulty multiplier for the item's category (loot_mult / ammo_mult / med_mult), rounded with random remainder, min 1"
  ],
