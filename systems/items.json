  "paperdoll": {
    "canvas_px": [
      48,
      96
    ],
    "asset_path": "assets/paperdoll/<paperdoll_layer>.png",
    "base_body": "assets/paperdoll/base_body.png",
    "draw_order": [
      "base",
      "legs",
      "feet",
      "torso",
      "hands",
      "wrap",
      "face",
      "head",
      "main_hand",
      "off_hand"
    ],
    "flag_layers": [
      {
        "flag": "has_gas_mask",
        "layer": "face_gas_mask",
        "slot": "face",
        "note": "Braith's Air Force gas mask (MCU-2/P-style full-face respirator, single side canister) from his deployment bag. Story flag (flags.json, set by gameplay_hooks ch08 chapter_start_effects). Not a lootable item. Drawn whenever the flag is true; occupies the face slot visually; mask_filter cartridges load into it."
      }
    ],
    "rules": {
      "slot_from_prefix": "slot = paperdoll_layer prefix (base_, legs_, feet_, torso_, hands_, wrap_, face_, head_, main_hand_, off_hand_)",
      "tint": "optional #rrggbb multiply-tint applied to the shared layer for colour variants",
      "two_handed": "if the main-hand item has two_handed: true, hide the off-hand layer",
      "weapons": "main_hand_ = currently equipped weapon (player.equipped); off_hand_ = flashlight when on, or a held torch"
    },
    "base_body_note": "Braith Pearce (25, Air Force crew chief) base body, 48x96, transparent background."
  },
  "revision": "Nevada Revision 2 (Sparks/Reno, Truckee Meadows, Lahontan Valley; player Braith Pearce)",
  "legacy_aliases_note": "js/config.js short ids + story v1->v2 maps that still point at live items. Retired v1 ids are NOT aliased: replace them in js/ and levels/ using README 'Revision 2 migration' (validator fails if any appear in systems JSON).",
  "clothing_fields": {
    "insulation": "0..1 warmth resistance; combined 1-prod(1-r), cap 0.75 (survival.json)",
    "wet_resist": "0..1 share of wetness blocked",
    "heat_penalty": "0..1 contribution to heat_load (sum over equipped). Compared against the chapter's heat_stress_insulation_threshold (survival.json heat_stress)",
    "breathability": "0..1 descriptive (1 = breathes freely); heat_penalty already accounts for it",
    "durability": "max durability; below 25% insulation halves"
  }
}
