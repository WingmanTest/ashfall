{
  "$schema_note": "See README.md#survivaljson. All rates are at difficulty tense_but_fair (1.0) and time_scale 1.0.",
  "version": 2,
  "time_model": {
    "source": "js/config.js CFG.dayLenSec",
    "day_length_real_seconds": 420,
    "in_game_minutes_per_real_second": 3.4286,
    "note": "The game ticks in real seconds (dt). Every rate below is given as per_real_second (authoritative; multiply by dt) and per_game_minute (= per_real_second / 3.4286, for UI/tooltips). If Echo changes dayLenSec, per_real_second values stay the same; only the per_game_minute column changes.",
    "night_fraction_of_day": 0.4,
    "time_skips_drain": "Story time-skips (Ch2 queue etc.) apply a flat cost: satiety -15, hydration -15, warmth set to min(warmth, 60). They do not tick rates."
  },
  "stats": {
    "warmth": {
      "key_stat": true,
      "code_field": "stats.warmth",
      "range": [
        0,
        100
      ],
      "start": 82,
      "unit": "points (100 = fully warm)",
      "base_drain": {
        "per_real_second": 0.3,
        "per_game_minute": 0.0875,
        "applies": "outdoors, calm weather, cold multiplier 1.0, no clothing"
      },
      "formula": "drain/s = base_drain * C * product(environment multipliers except 'night') * (1 - clothing_insulation) * difficulty.warmth_drain_mult, where C = chapter_climate[ch].cold_drain_mult by day and chapter_climate[ch].night_cold_mult at night (night_cold_mult is ABSOLUTE and already includes the night effect: do NOT also apply environment_modifiers.night). When C == 0 and no cold weather is active, warmth regenerates at chapter_climate[ch].ambient_warmth_regen_per_real_second. A source with 'regen' (fire, heated room) replaces the drain.",
      "clothing_insulation": {
        "combine": "1 - product(1 - r_i) over equipped clothing slots",
        "cap": 0.75
      },
      "thresholds": [
        {
          "id": "comfortable",
          "min": 60,
          "max": 100,
          "effects": {}
        },
        {
          "id": "chilled",
          "min": 40,
          "max": 60,
          "effects": {
            "stamina_regen_mult": 0.85
          },
          "hud": "breath fog"
        },
        {
          "id": "cold",
          "min": 20,
          "max": 40,
          "effects": {
            "stamina_regen_mult": 0.6,
            "aim_sway_mult": 1.4,
            "satiety_drain_mult": 1.25
          },
          "hud": "frost vignette, shiver audio"
        },
        {
          "id": "freezing",
          "min": 1,
          "max": 20,
          "effects": {
            "stamina_max": 50,
            "move_speed_mult": 0.85,
            "aim_sway_mult": 1.8,
            "health_per_real_second": -0.25
          },
          "hud": "heavy frost, heartbeat"
        },
        {
          "id": "hypothermic",
          "min": 0,
          "max": 1,
          "effects": {
            "no_sprint": true,
            "move_speed_mult": 0.7,
            "health_per_real_second": -1.2
          },
          "hud": "screen desaturates, death reason 'hypothermia'"
        }
      ],
      "warning_at": 30,
      "hud_note": "Story hud_unlocks: HUD hydration from ch01 (late summer), warmth + TEMP from ch03 (autumn). Warmth still ticks in ch01-02 (night chill only) but the bar is hidden until ch03."
    },
    "satiety": {
      "code_field": "stats.hunger",
      "note": "Code calls this 'hunger' but stores fullness (100 = full, drains to 0). Kept that convention; items use satiety +N (code used hunger: -N).",
      "range": [
        0,
        100
      ],
      "start": 70,
      "unit": "points (100 = full)",
      "base_drain": {
        "per_real_second": 0.055,
        "per_game_minute": 0.016
      },
      "modifiers": {
        "warmth_below_40": 1.25,
        "radiation_above_25": 1.3,
        "sick": 1.5,
        "sprinting": 1.2
      },
      "thresholds": [
        {
          "id": "fed",
          "min": 30,
          "max": 100,
          "effects": {}
        },
        {
          "id": "hungry",
          "min": 10,
          "max": 30,
          "effects": {
            "stamina_regen_mult": 0.7
          }
        },
        {
          "id": "starving",
          "min": 1,
          "max": 10,
          "effects": {
            "stamina_max": 60,
            "health_per_real_second": -0.15
          }
        },
        {
          "id": "empty",
          "min": 0,
          "max": 1,
          "effects": {
            "stamina_regen_mult": 0.35,
            "health_per_real_second": -0.4
          }
        }
      ],
      "companion": {
        "id": "wraith",
        "food_items_per_chapter": 2,
        "accepts": [
          "canned_food",
          "ration",
          "jerky",
          "mre"
        ],
        "note": "Wraith (Belgian Malinois) eats from inventory at rests: ~2 food items per chapter while wraith_alive. Unfed: she won't TRACK next chapter. Counted in the budget."
      }
    },
    "hydration": {
      "code_field": "stats.thirst",
      "range": [
        0,
        100
      ],
      "start": 75,
      "unit": "points (100 = fully hydrated)",
      "base_drain": {
        "per_real_second": 0.075,
        "per_game_minute": 0.0219
      },
      "modifiers": {
        "sprinting": 1.3,
        "near_fire": 1.2,
        "sick": 1.5,
        "eating_ration_or_mre": "-4 one-shot (salty)"
      },
      "thresholds": [
        {
          "id": "ok",
          "min": 30,
          "max": 100,
          "effects": {}
        },
        {
          "id": "thirsty",
          "min": 10,
          "max": 30,
          "effects": {
            "stamina_regen_mult": 0.8,
            "aim_sway_mult": 1.2
          }
        },
        {
          "id": "parched",
          "min": 1,
          "max": 10,
          "effects": {
            "health_per_real_second": -0.2,
            "vision_blur": true
          }
        },
        {
          "id": "dehydrated",
          "min": 0,
          "max": 1,
          "effects": {
            "health_per_real_second": -0.6
          }
        }
      ],
      "free_source": {
        "_note": "Anti-hard-lock valve: thirst can always be patched at some cost. Which source works depends on the chapter's season.",
        "by_season": {
          "late_summer": {
            "id": "drink_raw",
            "interaction": "hold USE at the Truckee River, Sparks Marina, an irrigation ditch or a stock tank",
            "hydration": 10,
            "chance_status": {
              "sick": 0.15
            },
            "cooldown_real_seconds": 6,
            "radiation": 0
          },
          "autumn": {
            "id": "drink_raw",
            "interaction": "hold USE at river/ditch/marina water or a rain barrel",
            "hydration": 10,
            "chance_status": {
              "sick": 0.12
            },
            "cooldown_real_seconds": 6,
            "radiation": 0
          },
          "late_fall": {
            "id": "drink_raw",
            "interaction": "hold USE at river/ditch water, puddles or rain barrels (freezing rain refills barrels)",
            "hydration": 10,
            "warmth": -3,
            "chance_status": {
              "sick": 0.1
            },
            "cooldown_real_seconds": 6,
            "radiation": 0
          },
          "nuclear_winter": {
            "id": "eat_snow",
            "interaction": "hold USE on snow outdoors",
            "hydration": 8,
            "warmth": -6,
            "chance_status": {
              "sick": 0.0
            },
            "cooldown_real_seconds": 6,
            "radiation": 5
          }
        }
      },
      "formula": "drain/s = base_drain * T * product(hydration modifiers) * heat_stress.hydration_mult * weather_modifiers[weather].thirst_mult (default 1) * difficulty.hydration_drain_mult, where T = chapter_climate[ch].thirst_drain_mult when outdoors in daytime, else chapter_climate[ch].thirst_drain_mult_night_or_indoors.",
      "water_sources": {
        "truckee_river": {
          "where": [
            "loc_sparks_block (river path)",
            "loc_virginia_bridge",
            "river_ice (Ch9: chop a hole)"
          ],
          "gives": "water_dirty",
          "sick_chance_raw": 0.3
        },
        "sparks_marina": {
          "where": [
            "loc_sparks_marina (ch01_lake_edge: bucket x4)"
          ],
          "gives": "water_dirty",
          "sick_chance_raw": 0.3
        },
        "irrigation_ditch": {
          "where": [
            "loc_us50_fallon (TCID canal)",
            "loc_tric_warehouses (drainage)",
            "loc_mustang_truckstop (stock tank)"
          ],
          "gives": "water_dirty",
          "sick_chance_raw": 0.35
        },
        "rain_barrel": {
          "where": [
            "loc_sparks_block",
            "loc_fourth_street"
          ],
          "seasons": [
            "autumn",
            "late_fall"
          ],
          "gives": "water_dirty",
          "sick_chance_raw": 0.15
        },
        "steamboat_hot_spring": {
          "where": [
            "loc_steamboat_creek",
            "loc_dixie_hotsprings"
          ],
          "gives": "water_dirty",
          "sick_chance_raw": 0.5,
          "note": "Mineral/arsenic geothermal water: boil does NOT fix it (still 0.25 sick after boiling); tablets do."
        },
        "melted_snow": {
          "where": [
            "anywhere outdoors"
          ],
          "seasons": [
            "nuclear_winter"
          ],
          "gives": "water_dirty",
          "note": "Carries fallout (radiation_by_act nuclear_winter)."
        },
        "cistern": {
          "where": [
            "loc_sparks_block (pruitt_cistern)",
            "loc_galena_station"
          ],
          "gives": "water_clean"
        }
      }
    },
