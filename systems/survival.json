  "revision": "Nevada Revision 2 + evolving seasonal curve (late_summer -> autumn -> late_fall -> nuclear_winter)",
  "heat_stress": {
    "_note": "NEW (late-summer blackout). Wearing winter gear in the heat costs water and stamina. Clean, data-driven: one number per chapter (heat_stress_insulation_threshold) and one per clothing item (heat_penalty).",
    "heat_load": "sum(item.heat_penalty) over equipped clothing (items.json)",
    "threshold_field": "chapter_climate[ch].heat_stress_insulation_threshold (null = no heat stress this chapter)",
    "applies": "daytime only; outdoors x1.0, indoors_unheated x0.5, near_fire x1.25; never at night",
    "excess": "max(0, heat_load - threshold) * applies_mult * difficulty.heat_stress_mult",
    "effects": {
      "hydration_mult": "1 + 3.0 * excess (cap 2.5)",
      "stamina_cost_mult": "1 + 2.0 * excess (cap 2.0)",
      "stamina_regen_mult": "max(0.5, 1 - 1.0 * excess)"
    },
    "thresholds": [
      {
        "id": "ok",
        "excess_max": 0.0,
        "effects": {}
      },
      {
        "id": "warm",
        "excess_max": 0.15,
        "hud": "sweat beads on the edges"
      },
      {
        "id": "overheated",
        "excess_max": 9,
        "effects": {
          "aim_sway_mult": 1.2,
          "no_sprint_above_excess": 0.4
        },
        "hud": "heat shimmer, sweat drip, 'OVERHEATED' tag",
        "death_reason_if_parched": "heatstroke"
      }
    ],
    "examples_late_summer_ch01": {
      "summer_kit (tee+jeans+sneakers+cap)": "heat_load 0.02 -> no stress",
      "flannel+work_jacket": "0.18 -> no stress",
      "wool coat over tee": "0.32 -> excess 0.12 -> thirst x1.36",
      "military_parka + snow_pants + pac boots": "0.68 -> excess 0.48 -> thirst x2.44 (water bar ~4.7 min in heat_haze), stamina costs x1.96, regen x0.52"
    }
  },
