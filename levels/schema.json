{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "levels/schema.json",
 "title": "ASHFALL: Truckee Meadows level (Revision 2)",
 "type": "object",
 "required": [
  "formatVersion",
  "storyVersion",
  "id",
  "chapter",
  "storyChapter",
  "title",
  "act",
  "next",
  "units",
  "grid",
  "environment",
  "locations",
  "buildings",
  "paths",
  "spawns",
  "props",
  "interactives",
  "safeZones",
  "setPieces",
  "encounters",
  "triggers",
  "objectives"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "formatVersion": {
   "const": 1
  },
  "storyVersion": {
   "const": 2
  },
  "id": {
   "type": "string",
   "pattern": "^ch[0-9]{2}b?_[a-z0-9_]+$"
  },
  "chapter": {
   "type": "integer",
   "minimum": 1,
   "maximum": 10
  },
  "storyChapter": {
   "type": "string",
   "pattern": "^ch[0-9]{2}$"
  },
  "title": {
   "type": "string"
  },
  "act": {
   "type": "integer",
   "minimum": 1,
   "maximum": 3
  },
  "next": {
   "type": [
    "string",
    "null"
   ]
  },
  "returnTo": {
   "type": [
    "string",
    "null"
   ]
  },
  "storyFile": {
   "type": "string"
  },
  "summary": {
   "type": "string"
  },
  "difficulty": {
   "type": "integer"
  },
  "units": {
   "const": "meters"
  },
  "startInventory": {
   "type": "object"
  },
  "storyEnemyTypes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "grid": {
   "type": "object",
   "required": [
    "cellSize",
    "cols",
    "rows",
    "origin",
    "legend",
    "tiles"
   ],
   "properties": {
    "cellSize": {
     "const": 2.0
    },
    "cols": {
     "type": "integer"
    },
    "rows": {
     "type": "integer"
    },
    "origin": {
     "type": "object",
     "required": [
      "x",
      "z"
     ],
     "properties": {
      "x": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "additionalProperties": true
    },
    "legend": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "name",
       "walkable",
       "solid",
       "height",
       "preview"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "walkable": {
        "type": "boolean"
       },
       "solid": {
        "type": "boolean"
       },
       "height": {
        "type": "number"
       },
       "preview": {
        "type": "string"
       },
       "floorTex": {
        "type": "string"
       },
       "wallTex": {
        "type": "string"
       },
       "groundType": {
        "type": "string"
       }
      },
      "additionalProperties": true
     }
    },
    "tiles": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": true
  },
  "environment": {
   "type": "object",
   "required": [
    "seasonArc",
    "season",
    "environmentPreset",
    "storySeason",
    "actName",
    "weather",
    "storyWeather",
    "tempC",
    "storyTempC",
    "groundType",
    "precipitation",
    "particles",
    "visibilityM",
    "fogNear",
    "fogFar",
    "fogColor",
    "skyColor",
    "snowCover",
    "timeStart",
    "atmosphere"
   ],
   "properties": {
    "seasonArc": {
     "enum": [
      "blackout_late_summer",
      "devolving_autumn",
      "civil_war_late_autumn",
      "fallout_nuclear_winter"
     ]
    },
    "season": {
     "enum": [
      "summer",
      "autumn",
      "late_fall",
      "fallout_winter"
     ]
    },
    "environmentPreset": {
     "enum": [
      "summer",
      "autumn",
      "late_fall",
      "fallout_winter"
     ]
    },
    "storySeason": {
     "enum": [
      "late_summer",
      "autumn",
      "late_fall",
      "nuclear_winter"
     ]
    },
    "weather": {
     "type": "string"
    },
    "storyWeather": {
     "type": "string"
    },
    "weatherOverride": {
     "type": "string"
    },
    "tempC": {
     "type": "number"
    },
    "storyTempC": {
     "type": "number"
    },
    "nightTempC": {
     "type": [
      "number",
      "null"
     ]
    },
    "groundType": {
     "type": "string"
    },
    "precipitation": {
     "enum": [
      "none",
      "cold_rain",
      "drizzle",
      "sleet",
      "ash_snow",
      "ash",
      "snow",
      "fallout_rain"
     ]
    },
    "particles": {
     "type": "string"
    },
    "visibilityM": {
     "type": "number"
    },
    "fogNear": {
     "type": "number"
    },
    "fogFar": {
     "type": "number"
    },
    "fogColor": {
     "type": "string",
     "pattern": "^#[0-9a-f]{6}$"
    },
    "skyColor": {
     "type": "string",
     "pattern": "^#[0-9a-f]{6}$"
    },
    "sunColor": {
     "type": "string"
    },
    "ambientColor": {
     "type": "string"
    },
    "snowCover": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "wetness": {
     "type": "number"
    },
    "windMs": {
     "type": "number"
    },
    "timeStart": {
     "type": "number"
    },
    "timeEnd": {
     "type": "number"
    },
    "timeLocked": {
     "type": "boolean"
    },
    "blizzard": {
     "type": "boolean"
    },
    "warmthDrainMul": {
     "type": "number"
    },
    "hud": {
     "type": "object"
    },
    "transitions": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "mechanics": {
     "type": "object"
    },
    "atmosphere": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "locations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "x",
     "z",
     "rect",
     "safe"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     },
     "rect": {
      "type": "object",
      "oneOf": [
       {
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        },
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ]
       },
       {
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number"
         }
        },
        "required": [
         "type",
         "x",
         "z",
         "r"
        ]
       }
      ]
     },
     "safe": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     }
    },
    "additionalProperties": true
   }
  },
  "landmarks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
