       "activate": {
        "enum": [
         "load",
         "trigger"
        ]
       },
       "storyEncounter": {
        "type": "string"
       },
       "variant": {
        "type": "string"
       },
       "ambush": {
        "type": "boolean"
       },
       "lowVisibilityTrigger": {
        "type": "boolean"
       },
       "torpid": {
        "type": "boolean"
       }
      },
      "additionalProperties": true
     }
    },
    "loot": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "x",
       "z",
       "container",
       "label",
       "r"
      ],
      "properties": {
       "id": {
        "type": "string"
