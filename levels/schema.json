       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "rotY": {
        "type": "number"
       },
       "when": {
        "description": "story/SCHEMA.md condition(s): {flag, eq|ne|gt|gte|lt|lte} | {item, gte} | {trust} | {any|all|none|not}",
        "anyOf": [
         {
          "type": "array"
         },
         {
          "type": "object"
         }
        ]
       }
      },
      "additionalProperties": true
     }
    },
