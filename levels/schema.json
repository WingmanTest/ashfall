      "type": "string"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "additionalProperties": true
   }
  },
  "buildings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "kind",
     "cells",
     "rect",
     "doors"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "walled",
       "mass"
      ]
     },
     "cells": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
     },
     "rect": {
      "type": "object",
      "oneOf": [
       {
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        },
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ]
       },
       {
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number"
         }
        },
        "required": [
         "type",
         "x",
         "z",
         "r"
        ]
       }
      ]
     },
     "doors": {
      "type": "array",
      "items": {
       "type": "array",
