        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "location": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "additionalProperties": true
   }
  },
  "paths": {
   "type": "object",
   "required": [
    "critical",
    "optional"
   ],
   "properties": {
    "critical": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "optional": {
     "type": "array"
    }
   },
   "additionalProperties": true
  },
  "spawns": {
   "type": "object",
   "required": [
    "player",
    "npcs",
    "enemies",
    "loot"
