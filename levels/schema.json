{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ashfall/levels/schema.json",
 "title": "ASHFALL: Lakehead level file",
 "description": "One chapter map. Units are meters. World axes match js/world.js: +x east (right), -z north (forward, away from the start), y up. rotY is radians about +Y (three.js); rotY=PI faces -z.",
 "type": "object",
 "required": [
  "formatVersion",
  "id",
  "chapter",
  "title",
  "units",
  "grid",
  "environment",
  "spawns",
  "props",
  "triggers",
  "objectives"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "formatVersion": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^ch[0-9]{2}_[a-z0-9_]+$"
  },
  "chapter": {
   "type": "integer",
   "minimum": 1
  },
  "title": {
   "type": "string"
  },
  "act": {
   "type": "string"
  },
  "storyFile": {
   "type": "string"
  },
  "next": {
   "type": [
    "string",
    "null"
   ]
  },
  "summary": {
   "type": "string"
  },
  "difficulty": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "units": {
   "const": "meters"
  },
  "grid": {
   "type": "object",
   "required": [
    "cellSize",
    "cols",
    "rows",
    "origin",
    "legend",
    "tiles"
   ],
   "additionalProperties": false,
   "properties": {
    "cellSize": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "cols": {
     "type": "integer",
     "minimum": 4
    },
    "rows": {
     "type": "integer",
     "minimum": 4
    },
    "origin": {
     "type": "object",
     "required": [
      "x",
      "z"
     ],
     "properties": {
      "x": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "additionalProperties": false,
     "description": "World position of the NW (top-left) corner of cell (col 0,row 0). Cell (c,r) spans x=[ox+c*cs, ox+(c+1)*cs], z=[oz+r*cs, oz+(r+1)*cs]."
    },
    "legend": {
     "type": "object",
     "propertyNames": {
      "minLength": 1,
      "maxLength": 1
     },
     "additionalProperties": {
      "$ref": "#/$defs/tile"
     }
    },
    "tiles": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "rows top(north,-z)->bottom(south,+z); each char = one cell"
    }
   }
  },
  "environment": {
   "$ref": "#/$defs/environment"
  },
  "locations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "x",
     "z"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     },
     "rect": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "type",
         "x",
         "z",
         "r"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        }
       }
      ]
     },
     "safe": {
      "type": "boolean"
     }
    },
    "additionalProperties": false
   }
  },
  "landmarks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "x",
     "z"
    ],
    "properties": {
     "label": {
      "type": "string"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "additionalProperties": false
   }
  },
  "paths": {
   "type": "object",
   "properties": {
    "critical": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "optional": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "points"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "label": {
        "type": "string"
       },
       "points": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       }
      }
     }
    }
   },
   "additionalProperties": false
  },
  "spawns": {
   "type": "object",
   "required": [
    "player"
   ],
   "additionalProperties": false,
   "properties": {
    "player": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "x",
       "z",
       "rotY"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "rotY": {
        "type": "number"
       },
       "when": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/condition"
        }
       }
      }
     }
    },
    "npcs": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "npc",
       "x",
       "z"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "npc": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "rotY": {
        "type": "number"
       },
       "behavior": {
        "type": "string"
       },
       "dialogue": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "when": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/condition"
        }
       },
       "label": {
        "type": "string"
       },
       "combatProfile": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       }
      }
     }
    },
    "enemies": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "type",
       "x",
       "z",
       "group"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "type": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "rotY": {
        "type": "number"
       },
       "patrolWaitSec": {
        "type": "number"
       },
       "group": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
       },
       "behavior": {
        "type": "string"
       },
       "patrol": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "hostile": {
        "enum": [
         "always",
         "on_provoke",
         "conditional",
         "never"
        ]
       },
       "hostileWhen": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/condition"
        }
       },
       "when": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/condition"
        }
       },
       "activate": {
        "enum": [
         "load",
         "trigger"
        ]
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "loot": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "x",
       "z",
       "container",
       "location"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "r": {
        "type": "number"
       },
       "label": {
        "type": "string"
       },
       "container": {
        "$ref": "#/$defs/sysid",
        "description": "systems/loot_tables.json container_types key"
       },
       "location": {
        "type": [
         "string",
         "null"
        ],
        "description": "area id (systems areas / story hooks locations) this container counts toward"
       },
       "filler": {
        "type": "boolean",
        "description": "auto-placed to meet the systems container budget"
       },
       "guaranteed": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "item",
          "n"
         ],
         "additionalProperties": false,
         "properties": {
          "item": {
           "type": "string",
           "pattern": "^[a-z0-9_]+$"
          },
          "n": {
           "type": "integer",
           "minimum": 1
          }
         }
        }
       },
       "when": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/condition"
        }
       },
       "setsFlag": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       }
      }
     }
    }
   }
  },
  "props": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "asset",
     "x",
     "z",
     "h"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "asset": {
      "type": "string",
      "pattern": "^assets/.+\\.(glb|gltf|png)$"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     },
     "rotY": {
      "type": "number"
     },
     "h": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "target height in m, applied with fitHeight()"
     },
     "collide": {
      "type": "boolean"
     },
     "tag": {
      "type": "string"
     }
    }
   }
  },
  "interactives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "x",
     "z",
     "r",
     "label"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     },
     "r": {
      "type": "number"
     },
     "label": {
      "type": "string"
     },
     "requiresItems": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      }
     },
     "requiresFlags": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     },
     "setsFlag": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "sequenceStep": {
      "type": "integer"
     },
     "when": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     }
    }
   }
  },
  "safeZones": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "x",
     "z",
     "r"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "kind": {
      "enum": [
       "campfire",
       "burn_barrel",
       "indoor",
       "sealed",
       "tent",
       "warm_room"
      ]
     },
     "x": {
      "type": "number"
     },
     "z": {
      "type": "number"
     },
     "r": {
      "type": "number"
     },
     "label": {
      "type": "string"
     },
     "warmth": {
      "type": "boolean"
     },
     "save": {
      "type": "boolean"
     },
     "sealed": {
      "type": "boolean"
     },
     "when": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     }
    }
   }
  },
  "setPieces": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "path": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "area": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "type",
         "x",
         "z",
         "r"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        }
       }
      ]
     },
     "when": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "encounters": {
   "type": "array",
   "description": "Encounter zones. Engine keeps only enemies of the zone containing the player alive (dormant otherwise). Waves: wave n+1 activates when wave n is cleared or fled (flag cleared.<group>).",
   "items": {
    "type": "object",
    "required": [
     "id",
     "area",
     "groups"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "area": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "type",
         "x",
         "z",
         "r"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        }
       }
      ]
     },
     "note": {
      "type": "string"
     },
     "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "group",
        "wave"
       ],
       "additionalProperties": false,
       "properties": {
        "group": {
         "type": "string",
         "pattern": "^[a-z0-9_]+$"
        },
        "wave": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  },
  "stealth": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "routes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "points"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "label": {
        "type": "string"
       },
       "points": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "blindSpots": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "shape"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
       },
       "shape": {
        "oneOf": [
         {
          "type": "object",
          "required": [
           "type",
           "x",
           "z",
           "r"
          ],
          "additionalProperties": false,
          "properties": {
           "type": {
            "const": "circle"
           },
           "x": {
            "type": "number"
           },
           "z": {
            "type": "number"
           },
           "r": {
            "type": "number",
            "exclusiveMinimum": 0
           }
          }
         },
         {
          "type": "object",
          "required": [
           "type",
           "x0",
           "z0",
           "x1",
           "z1"
          ],
          "additionalProperties": false,
          "properties": {
           "type": {
            "const": "rect"
           },
           "x0": {
            "type": "number"
           },
           "z0": {
            "type": "number"
           },
           "x1": {
            "type": "number"
           },
           "z1": {
            "type": "number"
           }
          }
         }
        ]
       },
       "note": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "triggers": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "on",
     "shape",
     "actions"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "on": {
      "enum": [
       "enter",
       "exit",
       "interact",
       "load",
       "flag"
      ]
     },
     "once": {
      "type": "boolean"
     },
     "shape": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "type",
         "x",
         "z",
         "r"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "circle"
         },
         "x": {
          "type": "number"
         },
         "z": {
          "type": "number"
         },
         "r": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "x0",
         "z0",
         "x1",
         "z1"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "rect"
         },
         "x0": {
          "type": "number"
         },
         "z0": {
          "type": "number"
         },
         "x1": {
          "type": "number"
         },
         "z1": {
          "type": "number"
         }
        }
       }
      ]
     },
     "when": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     },
     "note": {
      "type": "string"
     },
     "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "#/$defs/action"
      }
     }
    }
   }
  },
  "objectives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "order",
     "text",
     "completeWhen"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "order": {
      "type": "integer"
     },
     "text": {
      "type": "string",
      "maxLength": 60
     },
     "optional": {
      "type": "boolean"
     },
     "completeWhen": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     },
     "startWhen": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/condition"
      }
     }
    }
   }
  }
 },
 "$defs": {
  "tile": {
   "type": "object",
   "required": [
    "name",
    "walkable",
    "solid",
    "height"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string"
    },
    "walkable": {
     "type": "boolean"
    },
    "solid": {
     "type": "boolean"
    },
    "height": {
     "type": "number"
    },
