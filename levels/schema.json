     "type": "boolean"
    },
    "water": {
     "type": "boolean"
    },
    "ice": {
     "type": "boolean"
    },
    "void": {
     "type": "boolean"
    },
    "tree": {
     "type": "boolean"
    },
    "hazard": {
     "type": "string"
    },
    "blocksAirLOS": {
     "type": "boolean"
    },
    "gate": {
     "type": "boolean"
    },
    "preview": {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    }
   }
  },
  "condition": {
   "description": "Same shape as story/dialogue conditions: {flag, eq|ne|gt|gte|lt|lte}. Extensions: {item, gte|lt...} checks inventory count; {any:[...]} is OR. A list of conditions is AND.",
   "oneOf": [
    {
     "type": "object",
     "required": [
      "flag"
     ],
     "minProperties": 2,
     "maxProperties": 2,
     "properties": {
      "flag": {
       "type": "string"
      },
      "eq": {},
      "ne": {},
      "gt": {
       "type": "number"
      },
      "gte": {
       "type": "number"
      },
      "lt": {
       "type": "number"
      },
      "lte": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "item"
     ],
     "minProperties": 2,
     "maxProperties": 2,
     "properties": {
      "item": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      },
      "eq": {
       "type": "number"
      },
      "gt": {
       "type": "number"
      },
      "gte": {
       "type": "number"
      },
      "lt": {
       "type": "number"
      },
      "lte": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "any"
     ],
     "properties": {
      "any": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/condition"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "action": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "dialogue",
      "cutscene",
      "bark",
      "set_flag",
      "activate_group",
      "set_time",
      "set_weather",
      "checkpoint",
      "hud_unlock",
      "story_check",
      "start_sequence",
      "push_back",
      "spawn_setpiece",
      "chapter_end",
      "teleport"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "dialogue"
       }
      }
     },
     "then": {
      "required": [
       "id"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "cutscene"
       }
      }
     },
     "then": {
      "required": [
       "id",
       "text"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "bark"
       }
      }
     },
     "then": {
      "required": [
       "speaker",
       "text"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "set_flag"
       }
      }
     },
     "then": {
      "required": [
       "flag",
       "value"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "activate_group"
       }
      }
     },
     "then": {
      "required": [
       "group"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "set_time"
       }
      }
     },
     "then": {
      "required": [
       "value"
      ],
      "properties": {
       "value": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "set_weather"
       }
      }
     },
     "then": {
      "required": [
       "weather"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "hud_unlock"
       }
      }
     },
     "then": {
      "required": [
       "stat"
      ],
      "properties": {
       "stat": {
        "enum": [
         "hp",
         "warmth",
         "temp",
         "hunger",
         "rad",
         "filter",
         "seal",
         "ammo_military"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "story_check"
       }
      }
