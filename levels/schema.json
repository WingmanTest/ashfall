      "type": "object",
      "required": [
       "id",
       "x",
       "z",
       "type",
       "group",
       "hostile",
       "activate"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "type": {
        "type": "string"
       },
       "group": {
        "type": "string"
       },
       "tier": {
        "type": "integer"
       },
       "behavior": {
        "type": "string"
       },
       "patrol": {
        "type": "array",
        "items": {
         "type": "array",
