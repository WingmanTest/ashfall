     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "x",
       "z",
       "npc",
       "behavior"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "x": {
        "type": "number"
       },
       "z": {
        "type": "number"
       },
       "npc": {
        "type": "string"
       },
       "behavior": {
        "type": "string"
       },
       "dialogue": {
        "type": "string"
       },
       "when": {
        "description": "story/SCHEMA.md condition(s): {flag, eq|ne|gt|gte|lt|lte} | {item, gte} | {trust} | {any|all|none|not}",
        "anyOf": [
         {
          "type": "array"
         },
         {
          "type": "object"
         }
        ]
       },
       "label": {
        "type": "string"
       },
       "rotY": {
        "type": "number"
       },
       "trader": {
        "type": "object"
       },
       "crowd": {
        "type": "boolean"
       },
       "companion": {
        "type": "boolean"
       },
       "relocatedFrom": {
        "type": "string"
       }
      },
      "additionalProperties": true
     }
    },
    "enemies": {
     "type": "array",
