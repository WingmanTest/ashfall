      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "spawn_setpiece"
       }
      }
     },
     "then": {
      "required": [
       "id"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "chapter_end"
       }
      }
     },
     "then": {
      "required": [
       "next"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "teleport"
       }
      }
     },
